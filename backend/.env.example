# Minimised CRM - Environment Configuration Example
# Copy to .env and adjust variables as needed

# Django Secret Key & Debug
SECRET_KEY=django-insecure-+0^ym!8y8_v8&5^c0%zuq@i91)+5b%!n32h#7(h0a0itk=)ufo
DEBUG=True

# Allowed Hosts & CORS Origins (comma-separated)
ALLOWED_HOSTS=localhost,127.0.0.1,testserver,.onrender.com
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,https://your-frontend.vercel.app

# Email Settings (for Gmail SMTP in production; use a 16-character Google App Password)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-google-app-password
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=your-email@gmail.com

# Celery & Redis Task Queue Configuration
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=False
CELERY_SOCKET_TIMEOUT=2
CELERY_SOCKET_CONNECT_TIMEOUT=2
